# ============================================================
#  lotto-accounting — ตัวอย่างไฟล์ environment
#  คัดลอกเป็น .env.local แล้วเติมค่าจริง (อย่า commit ไฟล์ .env.local)
# ============================================================

# ---------- Supabase ----------
# Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — ใช้ฝั่ง server เท่านั้น ห้ามใส่ใน NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
# ชื่อ storage bucket สำหรับเก็บรูปสลิป (ต้องเป็น private bucket)
SUPABASE_STORAGE_BUCKET=slips

# ---------- LINE Login / LIFF (ใช้ล็อกอิน + ฟอร์มกรอกข้อมูล) ----------
# LINE Developers → LINE Login channel → LIFF → LIFF ID
NEXT_PUBLIC_LIFF_ID=
# LINE Login channel ID (ตัวเลข) — ใช้ตรวจสอบ ID token ฝั่ง server
LINE_LOGIN_CHANNEL_ID=

# ---------- LINE Messaging API (ไม่บังคับ — ใช้ดูสรุปยอดในแชท) ----------
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# ---------- อ่านวันที่/ยอดเงินจากรูป (OCR) ----------
# เลือกตัวอ่าน: auto (ค่าเริ่มต้น) | google | anthropic
# auto = มีคีย์ไหนใช้อันนั้น ถ้ามีทั้งคู่จะเลือก google เพราะถูกกว่ามาก
OCR_PROVIDER=auto

# --- Google Cloud Vision (แนะนำ — 1,000 รูปแรกต่อเดือนไม่มีค่าใช้จ่าย) ---
# Google Cloud Console → เปิดใช้ "Cloud Vision API" ก่อน
# แล้วไป APIs & Services → Credentials → Create credentials → API key
# ตั้ง API restrictions ให้ใช้ได้เฉพาะ Cloud Vision API (คีย์นี้อยู่ฝั่ง server เท่านั้น)
GOOGLE_VISION_API_KEY=
# ปล่อยว่างได้ ค่าเริ่มต้นคือ endpoint กลางของ Google
# GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate

# --- Claude (อ่านรูปแม่นกว่า แต่คิดเงินทุกรูป) ---
ANTHROPIC_API_KEY=
# ปล่อยว่างได้ ค่าเริ่มต้นคือ claude-opus-5
OCR_MODEL=claude-opus-5

# ---------- ทั่วไป ----------
# URL ของเว็บที่ deploy แล้ว (ใช้ทำปุ่มลิงก์ในข้อความ LINE)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# โซนเวลาที่ใช้ตัดยอดรายวัน/รายเดือน
APP_TIMEZONE=Asia/Bangkok
# ---------- สิทธิ์การใช้งาน ----------
# LINE userId ของผู้ดูแล คั่นด้วย comma — เข้าหน้า /admin เพื่ออนุมัติสมาชิกได้
# ผู้ดูแลเปิดใช้งานให้ตัวเองอัตโนมัติเสมอ จึงล็อกตัวเองออกจากระบบไม่ได้
# *** ต้องตั้งค่านี้ก่อนรัน migration 0003 ไม่งั้นจะไม่มีใครอนุมัติสมาชิกใหม่ได้ ***
LINE_ADMIN_USER_IDS=

# กันคนนอกแบบตายตัว (ไม่บังคับ) — ถ้าตั้งไว้ คนที่ไม่อยู่ในรายชื่อจะล็อกอินไม่ได้เลย
# ปกติไม่ต้องใช้ เพราะมีระบบอนุมัติสมาชิกที่หน้า /admin อยู่แล้ว
LINE_ALLOWED_USER_IDS=

# ---------- สำหรับ dev เท่านั้น (ห้ามเปิดบน production) ----------
# ตั้ง true เพื่อข้าม LINE Login ตอนพัฒนาในเครื่อง
DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_LINE_USER_ID=
